<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/bg_header_gradient"
        app:titleTextColor="#FFFFFF" />

    <!-- Scheme Details in ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Demo notice -->
            <TextView
                android:id="@+id/tv_demo_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ DEMO DATA — For academic demonstration only. Verify from official government portals."
                android:textColor="@color/status_verify"
                android:textSize="12sp"
                android:background="@color/status_verify_bg"
                android:padding="10dp"
                android:layout_marginBottom="12dp" />

            <!-- Scheme Name + Category -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:id="@+id/tv_category"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textColor="@color/primary" android:textSize="12sp" android:textStyle="bold"
                        android:background="@drawable/bg_badge_eligible" android:padding="6dp"
                        android:paddingStart="10dp" android:paddingEnd="10dp" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_scheme_name"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="20sp" android:textStyle="bold"
                        android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_match_status"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:textSize="14sp" android:textStyle="bold" android:layout_marginBottom="4dp" />
                    <!-- Deadline -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:id="@+id/tv_deadline"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:textColor="@color/text_secondary" android:textSize="13sp" />
                        <TextView android:id="@+id/tv_days_left"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:textSize="12sp" android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Summary Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📝 Summary" android:textColor="@color/primary"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_summary"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Why This May Match You -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp"
                app:cardBackgroundColor="@color/status_eligible_bg">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🟢 Why This May Match You" android:textColor="@color/status_eligible"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_match_reason"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/status_eligible" android:textSize="13sp"
                        android:lineSpacingExtra="3dp" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="⚠️ Final eligibility must be verified from the official government authority."
                        android:textColor="@color/status_verify" android:textSize="11sp"
                        android:layout_marginTop="8dp" android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Benefits Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💰 Benefits" android:textColor="@color/primary"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_benefits"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Eligibility Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📋 Eligibility" android:textColor="@color/primary"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_eligibility"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:lineSpacingExtra="3dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Documents Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:id="@+id/ll_document_checklist"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📄 Documents Required" android:textColor="@color/primary"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_documents"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:lineSpacingExtra="4dp" android:fontFamily="monospace" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- How to Apply Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📝 How to Apply" android:textColor="@color/primary"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_steps"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Application Tracker Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:id="@+id/ll_application_tracker"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊 Application Status" android:textColor="@color/primary"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp" />
                    <ProgressBar
                        android:id="@+id/progress_application"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent" android:layout_height="16dp"
                        android:max="100" android:progress="0"
                        android:progressTint="@color/primary"
                        android:layout_marginBottom="8dp" />
                    <TextView android:id="@+id/tv_app_status"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Not Started — tap to update"
                        android:textColor="@color/text_secondary" android:textSize="13sp"
                        android:gravity="center" android:padding="8dp"
                        android:background="@drawable/bg_badge_possibly" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Links Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="4dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔗 Important Links" android:textColor="@color/primary"
                        android:textSize="15sp" android:textStyle="bold" android:layout_marginBottom="12dp" />
                    <Button android:id="@+id/btn_official_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="🌐 Official Website"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        style="@style/ButtonOutlined"
                        android:layout_marginBottom="10dp" />
                    <Button android:id="@+id/btn_guidelines_link"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="📋 View Guidelines &amp; Rules"
                        android:textColor="@color/primary"
                        android:textSize="15sp"
                        style="@style/ButtonOutlined" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Save Button -->
            <ProgressBar android:id="@+id/progress_bar"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center" android:indeterminateTint="@color/primary"
                android:visibility="gone" android:layout_marginBottom="8dp" />
            <Button android:id="@+id/btn_save"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="⭐ Save Scheme"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                style="@style/ButtonPrimary"
                android:layout_marginBottom="16dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
